table Empleados
	lineageTag: a9e58223-ab65-4d66-90ea-e5587f167a09

	measure 'Total Empleados' = COUNTROWS(Empleados)
		formatString: 0
		lineageTag: 6a746d55-7f01-481d-9bd8-1209c6d04339

	measure 'Empleados Riesgo Alto' = CALCULATE(COUNTROWS(Empleados),Empleados[categoria_riesgo]="Alto")
		formatString: 0
		lineageTag: c549ba1e-7e5c-4dbd-8574-1dd32cf65ae1

	measure '% Riesgo Alto' = DIVIDE(CALCULATE(COUNTROWS(Empleados),Empleados[categoria_riesgo]="Alto"),COUNTROWS(Empleados),0)
		formatString: 0.0%
		lineageTag: d9e041de-3777-485b-9f90-42b56d5fd5c2

	measure 'Score Riesgo Prom' = AVERAGE(Empleados[riesgo_score])
		formatString: 0.00
		lineageTag: 248c74fd-ac0d-4fcf-9a01-2a52cdb1171e

	measure 'Horas Cap Promedio' = AVERAGE(Empleados[capacitacion_hs_a])
		formatString: 0
		lineageTag: cd7d6db3-2760-4858-904b-77d18ad3b274

